# LLM 配置模板：复制为 .env 后填写真实值（.env 不入库）
# 注意：opencode_go_api / deepseek_api 为小写键名（历史约定，Windows 下环境变量大小写敏感）
opencode_go_api=你的API_KEY
# OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
# OPENCODE_GO_MODEL=mimo-v2.5

# ---- W8 LLM 供应商选项（KA_LLM_PROVIDER 切换；deepseek 为官方 api.deepseek.com 端点）----
# KA_LLM_PROVIDER=opencode_go           # opencode_go | deepseek
# deepseek_api=你的DEEPSEEK_KEY
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-flash

# ---- LLM 客户端行为（W8 eval-fixes）----
# KA_LLM_TIMEOUT_S=120                  # 单次请求超时秒数（部署必须显式设置；未设时 SDK 默认 600s）
# KA_LLM_MAX_RETRIES=2                  # SDK 原生重试次数

# W3 Docker Sandbox（可选，默认值即注释所示）
# KA_EXECUTOR=local                # 命令执行器: local(宿主机) / docker(容器沙箱)
# KA_SANDBOX_IMAGE=ka-sandbox:py312-v1
# KA_SANDBOX_CPUS=2                # 容器 CPU 核数
# KA_SANDBOX_MEMORY=1g             # 容器内存上限
# KA_SANDBOX_PIDS=512              # 容器 PID 上限
# KA_SANDBOX_NETWORK=0             # 1 = 创建时容器带网络（任务级 opt-in）
# KA_SANDBOX_REPO_URL=             # workspace 为空时创建阶段克隆的仓库

# W4 Repository Intelligence（可选）
# ARKNIGHTS_USE_MCP=1                              # 启用域知识检索（Arknights Wiki）
# ARKNIGHTS_WIKI_DIR=D:\AI project\Arknights LLM Wiki   # 兄弟项目根目录
# KA_CODE_INDEX=1                                 # 任务启动时自动构建代码索引（0 关闭）

# W5 GitHub Issue Agent（可选）
# GH_TOKEN=                               # GitHub 认证令牌（或 gh auth login；不入库）
# KA_GITHUB_BRANCH_PREFIX=fix/issue-     # 分支前缀
# KA_APPROVAL_DIR=output/approvals       # 审批单输出目录（--issue 产单停等）

# W5 知识抽查（Knowledge Correction 第一阶段；复用 ARKNIGHTS_WIKI_DIR）
# KA_CORRECT_OUT=output/correction       # 抽查报告输出目录（--audit-out 覆盖）

# ---- W8 实测补强（2026-08-29）----
# KA_ISSUE_SETUP_COMMANDS=               # 沙箱创建后逐条执行的任务级环境准备（&& 分隔；如
                                         # "pip install -e . --no-build-isolation"）
# KA_TEST_TIMEOUT_S=120                  # run_tests 超时秒数（大测试套件需调大）
# KA_REDLINE_PATTERNS=cost_log,generated_at  # 红线模式覆盖（逗号分隔子串；空=默认）

# ---- W6/W7 可观测（可选；需 pip install ".[eval]"）----
# KA_TRACING=                            # 1 启用 Langfuse tracing（默认读 LANGFUSE 键存在性）
# LANGFUSE_PUBLIC_KEY=                   # Langfuse SDK 三键（或兄弟项目 .env 的
# LANGFUSE_SECRET_KEY=                   #   LANGFUSE_INIT_PROJECT_PUBLIC/SECRET_KEY 运行时映射）
# LANGFUSE_BASE_URL=http://localhost:3000
# CLICKHOUSE_PASSWORD=                   # --trace-report 回退直查 events_core 用（本地 compose 默认 clickhouse）
# 注意（IM-17 有意取舍）：generation 只上报模型/用量/成本，不写入对话消息文本
#   （避免仓库代码/任务细节落入观测存储）——Langfuse 面板看不到对话内容属预期行为。
